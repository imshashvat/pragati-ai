ml/artifacts/*.joblib
ml/artifacts/*.pkl
ml/artifacts/*.onnx
ml/artifacts/*.cbm
ml/artifacts/*.h5
ml/artifacts/*.pt
ml/artifacts/*.pth
!ml/artifacts/.gitkeep
!ml/notebook/.gitkeep
