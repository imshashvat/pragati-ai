ml/artifacts/*.h5
ml/artifacts/*.pt
ml/artifacts/*.pth
# These specific model files are small enough to commit:
!ml/artifacts/model_3_schedule_delay.cbm
!ml/artifacts/model_3_schedule_config.pkl
!ml/artifacts/model_3_feature_importance.pkl
!ml/artifacts/.gitkeep
!ml/notebook/.gitkeep
