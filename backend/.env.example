# ==============================================================================
# PRAGATI-AI Backend Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it with real credentials.
# ==============================================================================

# ── Database ───────────────────────────────────────────────────────────────────
# Option A: SQLite (local dev — no setup needed)
DATABASE_URL=sqlite:///./pragati.db

# Option B: Supabase PostgreSQL (production)
# Get this from: Supabase Dashboard → Settings → Database → Connection string → URI
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Option C: Supabase with Transaction Pooler (recommended for serverless deploys)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── JWT Secret ─────────────────────────────────────────────────────────────────
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_THIS_IS_ONLY_FOR_PROTOTYPE

# ── ML Artifacts ───────────────────────────────────────────────────────────────
# Path to the directory containing your trained CatBoost model files.
# Default (relative to backend/): ../ml/artifacts/
# ML_ARTIFACTS_DIR=../ml/artifacts

# ── Risk Scoring ───────────────────────────────────────────────────────────────
# overall_risk >= RISK_THRESHOLD → alert is created
RISK_THRESHOLD=0.45

# ── CORS ───────────────────────────────────────────────────────────────────────
# Your frontend URL — update for production
FRONTEND_ORIGIN=http://localhost:5173

# ── Supabase (Optional — only if using Supabase client SDK directly) ───────────
# Get from: Supabase Dashboard → Settings → API
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
