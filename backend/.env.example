# PRAGATI-AI Backend — Environment Variables
# Copy this to .env for local dev, set these in Railway for production

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev: leave as SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./pragati.db
# Production (Supabase): uncomment and fill in your Supabase connection string
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── JWT Authentication ────────────────────────────────────────────────────────
# IMPORTANT: Change this in production! Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_openssl_rand_-hex_32

# ── CORS ─────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL (or localhost for dev)
FRONTEND_ORIGIN=http://localhost:5173
# Add extra origins separated by commas (useful for multiple Vercel preview URLs)
# EXTRA_CORS_ORIGINS=https://my-app.vercel.app,https://my-app-preview.vercel.app

# ── ML Artifacts ─────────────────────────────────────────────────────────────
# Path to ML model artifacts relative to repo root
# Default auto-detected. Override if needed.
# ML_ARTIFACTS_DIR=ml/artifacts

# ── Risk Threshold ────────────────────────────────────────────────────────────
RISK_THRESHOLD=0.45

# ── Supabase (optional) ───────────────────────────────────────────────────────
# Only needed for direct Supabase client calls (not SQLAlchemy DB connection)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
